    {
      "do": "hold",
      "ms": 400
    },
    {
      "do": "zoom",
      "scale": 1.6,
      "on": "a[href=\"/booking\"]:has-text(\"Book Appointment\")",
      "ms": 900
    },
    {
      "do": "click",
      "on": "a[href=\"/booking\"]:has-text(\"Book Appointment\")",
