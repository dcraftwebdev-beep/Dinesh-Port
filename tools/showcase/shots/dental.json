    {
      "do": "hold",
      "ms": 800
    },
    {
      "do": "type",
      "into": "input[name=\"firstName\"]",
      "text": "Jane"
    },
    {
      "do": "type",
      "into": "input[name=\"lastName\"]",
      "text": "Doe"
    },
    {
      "do": "type",
      "into": "input[name=\"email\"]",
      "text": "jane@example.com"
    },
    {
      "do": "zoom",
      "scale": 1.4,
      "on": "button:has-text(\"Confirm Appointment\")",
