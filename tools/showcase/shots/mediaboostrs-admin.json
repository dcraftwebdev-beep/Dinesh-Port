{
  "url": "https://www.mediaboostrs.com/admin",
  "label": "mediaboostrs.com/admin",
  "out": "tools/showcase/out/mediaboostrs-admin-showcase.mp4",
  "fps": 60,
  "storageState": "tools/showcase/.auth/mediaboostrs.json",
  "blurEmails": true,
  "background": ["#c3d6ef", "#cfd3f5", "#9fc2f2"],
  "shots": [
    { "do": "goto" },
    { "do": "click", "on": "button:has-text(\"Live\")", "silent": true, "wait": 1200 },
    { "do": "hold", "ms": 1000 },
    { "do": "move", "to": "button:has-text(\"All Posts\")", "ms": 900 },
    { "do": "hold", "ms": 300 },
    { "do": "move", "to": "button:has-text(\"Drafts\")", "ms": 700 },
    { "do": "hold", "ms": 400 },
    { "do": "zoom", "scale": 1.35, "on": "text=Live Posts", "ms": 900 },
    { "do": "hold", "ms": 900 },
    { "do": "zoom", "scale": 1, "ms": 700 },
    { "do": "type", "into": "input[placeholder*=\"Search\"]", "text": "digital", "cps": 9 },
    { "do": "hold", "ms": 700 },
    { "do": "move", "to": "button:text-is(\"Content Marketing\")", "ms": 900 },
    { "do": "move", "to": "button:text-is(\"Analytics\")", "ms": 800 },
    { "do": "hold", "ms": 300 },
    { "do": "zoom", "scale": 1.4, "on": "text=PUBLISHED", "ms": 900 },
    { "do": "hold", "ms": 1200 },
    { "do": "zoom", "scale": 1, "ms": 700 },
    { "do": "click", "on": "button:has-text(\"New Post\") >> nth=1", "wait": 1500 },
    { "do": "hold", "ms": 700 },
    { "do": "type", "into": "input[placeholder*=\"compelling title\"]", "text": "5 local SEO wins for Chennai businesses", "cps": 16 },
    { "do": "type", "into": "textarea[placeholder*=\"short, engaging\"]", "text": "Simple fixes that help nearby customers find you on Google this month.", "cps": 22 },
    { "do": "hold", "ms": 500 },
    { "do": "zoom", "scale": 1.35, "on": "text=Body Content", "ms": 900 },
    { "do": "move", "to": ".ql-toolbar", "ms": 900 },
    { "do": "hold", "ms": 700 },
    { "do": "zoom", "scale": 1, "ms": 700 },
    { "do": "move", "to": "text=Click or drag to upload", "ms": 1000 },
    { "do": "hold", "ms": 500 },
    { "do": "zoom", "scale": 1.4, "on": "text=SETTINGS", "ms": 900 },
    { "do": "move", "to": "input[placeholder*=\"tags\"]", "ms": 1000 },
    { "do": "hold", "ms": 900 },
    { "do": "zoom", "scale": 1, "ms": 700 },
    { "do": "move", "to": "text=Publish Article >> nth=0", "ms": 1000 },
    { "do": "hold", "ms": 1500 }
  ]
}
